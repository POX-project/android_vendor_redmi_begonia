<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_GNSS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gnss"/>
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_GPS"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gps"/>
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_NMEA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nmea"/>
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_INFO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info"/>
        </RadioGroup>
        <RadioGroup
            android:gravity="right"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_Page1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page1"/>
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_Page2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page2"/>
            <RadioButton
                android:textSize="13sp"
                android:id="@+id/RadioButton_Page3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page3"/>
        </RadioGroup>
    </LinearLayout>
    <com.mediatek.lbs.em2.ui.ViewGnss
        android:id="@+id/viewgnss"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.mediatek.lbs.em2.ui.ViewGps
        android:id="@+id/viewgps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.mediatek.lbs.em2.ui.ViewNmea
        android:id="@+id/viewnmea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
