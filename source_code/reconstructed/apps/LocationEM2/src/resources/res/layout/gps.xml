<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="left"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:id="@+id/linearLayout1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ToggleButton
                android:textSize="15dp"
                android:id="@+id/Button_StartGPS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOn="@string/gps_on"
                android:textOff="@string/gps_off"/>
            <Button
                android:textSize="15dp"
                android:id="@+id/Button_Once"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"/>
            <Button
                android:textSize="15dp"
                android:id="@+id/Button_ChangeRefLatLng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ref_latlng"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linearLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="15dp"
                android:id="@+id/Button_GpsMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gps_mode"/>
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_DeleteAidingData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="250dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ToggleButton
                android:textSize="15dp"
                android:id="@+id/Button_Stress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOn="@string/stress_on"
                android:textOff="@string/stress_off"/>
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_Loop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="200dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:textSize="15dp"
                android:id="@+id/CheckBox_LogNmea"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/log_nmea"/>
            <CheckBox
                android:textSize="15dp"
                android:id="@+id/CheckBox_LogToSdcard"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/log_to_sdcard"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linearLayout5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:textSize="15dp"
                android:id="@+id/CheckBox_LowPowerMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/low_power_mode"/>
            <CheckBox
                android:textSize="15dp"
                android:id="@+id/CheckBox_SingleShot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="@string/single_shot"/>
            <Button
                android:textSize="15dp"
                android:id="@+id/Button_ClearLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_log"/>
        </LinearLayout>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="15dp"
            android:id="@+id/TextView_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="15dp"
            android:id="@+id/TextView_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="15dp"
            android:id="@+id/TextView_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/TextView_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:id="@+id/TextView_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:id="@+id/TextView_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#ff00ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stress_test_settings"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_NumOfLoop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/num_of_fix"
                android:width="230dp"/>
            <EditText
                android:textSize="18dp"
                android:id="@+id/EditText_NumOfLoop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="100dp"
                android:maxLength="3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_Delay2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delay_before_deleting_data"
                android:width="230dp"/>
            <EditText
                android:textSize="18dp"
                android:id="@+id/EditText_Delay2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="100dp"
                android:maxLength="3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_Delay1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delay_before_starting_gps"
                android:width="230dp"/>
            <EditText
                android:textSize="18dp"
                android:id="@+id/EditText_Delay1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="100dp"
                android:maxLength="3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_Delay3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/session_timeout"
                android:width="230dp"/>
            <EditText
                android:textSize="18dp"
                android:id="@+id/EditText_Delay3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="100dp"
                android:maxLength="3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15dp"
                android:id="@+id/TextView_Delay4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delay_before_stopping_gps"
                android:width="230dp"/>
            <EditText
                android:textSize="18dp"
                android:id="@+id/EditText_Delay4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:width="100dp"
                android:maxLength="3"
                android:inputType="number"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_switchDeleteToFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_aiding_data_first"/>
        </LinearLayout>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="#ff00ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/black_list"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockGpsSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_gps_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockGps"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockSbasSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_sbas_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockSbas"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockGlonassSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_glonass_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockGlonass"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockQzssSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_qzss_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockQzss"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockBeidouSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_beidou_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockBeidou"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockGalileoSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_galileo_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockGalileo"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <CheckBox
                android:id="@+id/checkBox_BlockIrnssSatellites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/block_irnss_satellites"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/TextView_BlockIrnss"
                android:lines="1"
                android:width="150dp"
                style="@style/info_state_value"/>
        </LinearLayout>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#ff00ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Information"/>
        <LinearLayout style="@style/entry_layout">
            <TextView
                android:text="@string/has_almanac"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/TextView_HasAlmanacValue"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView
                android:text="@string/almanac_date"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/TextView_AlmanacDateValue"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView
                android:text="@string/year_of_gnss_hw"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/TextView_YearOfGnssHwValue"
                style="@style/info_state_value"/>
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView
                android:text="@string/gnss_hw_name"
                style="@style/info_label"/>
            <TextView
                android:id="@+id/TextView_GnssHwNameValue"
                style="@style/info_state_value"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
