<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="left"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="left"
            android:orientation="vertical"
            android:id="@+id/LinearLayout_Debug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#ff00ff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_button"/>
            <ToggleButton
                android:id="@+id/toggleButton_regress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textOn="@string/stress_on"
                android:textOff="@string/stress_off"/>
        </LinearLayout>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ff00ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/navigation"/>
        <ToggleButton
            android:id="@+id/toggleButton_navigation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="@string/on"
            android:textOff="@string/off"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/TextView_navi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ff00ff"
            android:id="@+id/TextView_meas_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/measurement"/>
        <ToggleButton
            android:id="@+id/toggleButton_measurement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="@string/on"
            android:textOff="@string/off"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/TextView_meas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ff00ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/measurement_corrections"/>
        <Button
            android:textSize="15sp"
            android:id="@+id/Button_MeasurementCorrection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inject_corrections"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/TextView_meas_correction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#ff909090"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#ff00ff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/antenna_information"/>
        <ToggleButton
            android:id="@+id/toggleButton_antenna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="@string/on"
            android:textOff="@string/off"/>
        <TextView
            android:textSize="13dp"
            android:id="@+id/TextView_antenna"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
