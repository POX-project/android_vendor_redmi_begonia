//
// LineageOS Reconstructed Application for Begonia (Redmi Note 8 Pro)
//

android_app {
    name: "LocationEM2",
    srcs: [
        "src/sources/**/*.java",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    vendor: true,
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
}
