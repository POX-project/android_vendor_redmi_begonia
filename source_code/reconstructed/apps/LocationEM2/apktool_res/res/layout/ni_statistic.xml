<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="left" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="left" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent">
            <ToggleButton android:textSize="13.0sp" android:id="@id/toggleButton_NiStatistic" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textOn="@string/niSta_on" android:textOff="@string/niSta_off" />
            <Button android:textSize="13.0sp" android:id="@id/button_Call" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto_dialer" />
        </LinearLayout>
        <TextView android:textSize="20.0dp" android:textStyle="bold" android:textColor="#ff00ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/session_status" />
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/yield_rate_count" style="@style/info_label" />
            <TextView android:id="@id/TextNi_YieldRateCountValue" style="@style/info_state_value" />
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/yield_rate" style="@style/info_label" />
            <TextView android:id="@id/TextNi_YieldRateValue" style="@style/info_state_value" />
        </LinearLayout>
        <TextView android:textSize="20.0dp" android:textStyle="bold" android:textColor="#ff00ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/msb" />
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/report_location" style="@style/info_label" />
            <TextView android:id="@id/TextNi_ReportLocationValue" style="@style/info_state_value" />
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/min_max_distance" style="@style/info_label" />
            <TextView android:id="@id/TextNi_MimMaxDistanceValue" style="@style/info_state_value" />
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/distance_of_success_fixes" style="@style/info_label" />
            <TextView android:id="@id/TextNi_DistanceOfFixesValue" style="@style/info_state_value" />
        </LinearLayout>
        <TextView android:textSize="20.0dp" android:textStyle="bold" android:textColor="#ff00ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/msa" />
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/sv_count" style="@style/info_label" />
            <TextView android:id="@id/TextNi_SvCountValue" style="@style/info_state_value" />
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/sv_snr" style="@style/info_label" />
            <TextView android:id="@id/TextNi_SvSnrValue" style="@style/info_state_value" />
        </LinearLayout>
        <View android:background="#ff909090" android:layout_width="match_parent" android:layout_height="1.0dp" />
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/report_path" style="@style/info_label" />
            <TextView android:id="@id/TextView_ReportPath" style="@style/info_state_value" />
            <Button android:textSize="14.0sp" android:id="@id/button_ClearReports" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/clear_reports" />
        </LinearLayout>
        <LinearLayout style="@style/entry_layout">
            <TextView android:text="@string/ref_location" style="@style/info_label" />
            <TextView android:id="@id/TextNi_RefLocationValue" style="@style/info_state_value" />
        </LinearLayout>
        <View android:background="#ff909090" android:layout_width="match_parent" android:layout_height="1.0dp" />
        <TextView android:textSize="20.0dp" android:textStyle="bold" android:textColor="#ff00ff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/all_sessions" />
        <TextView android:textSize="12.0dp" android:id="@id/TextView_FixResultsValue" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
