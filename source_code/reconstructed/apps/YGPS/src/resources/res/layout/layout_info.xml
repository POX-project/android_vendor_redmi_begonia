<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1">
        <TableRow>
            <TextView
                android:text="@string/title_provider"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_provider"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_status"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_status"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_ttff"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_ttff"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_date"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_date"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_time"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_time"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/first_latitude_text"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/first_latitude_text"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/first_longtitude_text"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/first_longtitude_text"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_lat"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_latitude"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_lon"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_longitude"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_alt"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_altitude"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_acc"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_accuracy"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_bear"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_bearing"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_speed"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_speed"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_distance"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_distance"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_chip_version"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_chip_version"
                android:text="@string/text_unknown"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_mnl_version"
                style="@style/style_table_left"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/tv_mnl_version"
                android:text="@string/text_unknown"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_dsp_version"
                style="@style/style_table_left"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/tv_dsp_version"
                android:text="@string/text_unknown"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_clock_type"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_clock_type"
                android:text="@string/gps_status_unknown"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/light_gray"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:text="@string/title_clock_buffer"
                style="@style/style_table_left"/>
            <TextView
                android:id="@+id/tv_clock_buffer"
                android:text="@string/gps_status_unknown"
                style="@style/style_table_right"/>
        </TableRow>
        <View
            android:background="@color/gray"
            android:layout_height="1dp"/>
        <LinearLayout android:layout_height="wrap_content">
            <CheckBox
                android:id="@+id/cb_gps_epo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/enable_gps_epo"
                android:layout_weight="1"/>
            <CheckBox
                android:id="@+id/cb_gps_qepo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/enable_gps_qepo"
                android:layout_weight="1"/>
        </LinearLayout>
        <CheckBox
            android:id="@+id/cb_gps_log"
            android:layout_height="wrap_content"
            android:text="@string/gpslog_enable"/>
        <LinearLayout android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_hot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hot"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_warm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/warm"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_cold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cold"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_full"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/full"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_restart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/restart"
                android:layout_weight="1"/>
        </LinearLayout>
    </TableLayout>
</ScrollView>
