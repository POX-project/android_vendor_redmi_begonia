<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="2"
    android:versionName="2.0"
    android:compileSdkVersion="30"
    android:compileSdkVersionCodename="11"
    package="com.mediatek.emcamera"
    platformBuildVersionCode="30"
    platformBuildVersionName="11">
    <uses-sdk
        android:minSdkVersion="30"
        android:targetSdkVersion="30"/>
    <permission
        android:label="EmCamnera usage"
        android:name="com.mediatek.emcamera.permission.USAGE"
        android:protectionLevel="signature"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD"/>
    <application
        android:theme="@android:style/Theme.Holo"
        android:label="@string/app_name"
        android:extractNativeLibs="false"
        android:appComponentFactory="android.support.v4.app.CoreComponentFactory">
        <activity
            android:label="@string/app_name"
            android:icon="@drawable/ic_em_camera"
            android:name="com.mediatek.emcamera.AutoCalibration"
            android:permission="com.mediatek.emcamera.permission.USAGE"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|orientation|keyboardHidden"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen"
            android:name="com.mediatek.emcamera.CaptureActivity"
            android:taskAffinity="android.task.camera"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="portrait"
            android:configChanges="screenSize|orientation|keyboardHidden|mnc|mcc"/>
    </application>
</manifest>
