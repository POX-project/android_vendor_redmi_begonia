<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="#ff7c00" android:endColor="#ffa33d" android:angle="90.0" />
            <stroke android:width="1.0dp" android:color="#fd9417" />
            <corners android:radius="1.0dp" />
            <padding android:left="3.0dp" android:top="1.0dp" android:right="3.0dp" android:bottom="1.0dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient android:startColor="#ff7c00" android:endColor="#ffa33d" android:angle="90.0" />
            <stroke android:width="1.0dp" android:color="#fd9417" />
            <corners android:radius="1.0dp" />
            <padding android:left="3.0dp" android:top="1.0dp" android:right="3.0dp" android:bottom="1.0dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:startColor="#eb9212" android:endColor="#fcd673" android:angle="90.0" />
            <stroke android:width="1.0dp" android:color="#dc6b00" />
            <corners android:radius="1.0dp" />
            <padding android:left="3.0dp" android:top="1.0dp" android:right="3.0dp" android:bottom="1.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#25486e" android:endColor="#6f859c" android:angle="90.0" />
            <stroke android:width="1.0dp" android:color="#06274a" />
            <corners android:radius="1.0dp" />
            <padding android:left="3.0dp" android:top="1.0dp" android:right="3.0dp" android:bottom="1.0dp" />
        </shape>
    </item>
</selector>
