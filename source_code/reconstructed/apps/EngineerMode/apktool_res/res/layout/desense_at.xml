        <Button android:textSize="16.0sp" android:id="@id/desense_at_test_items_btn" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="@string/desense_at_test_items" android:layout_weight="1.0" />
        <Button android:textSize="16.0sp" android:id="@id/desense_at_band_btn" android:layout_width="0.0dp" android:layout_height="wrap_content" android:text="@string/desense_at_gnss_band" android:layout_weight="1.0" />
