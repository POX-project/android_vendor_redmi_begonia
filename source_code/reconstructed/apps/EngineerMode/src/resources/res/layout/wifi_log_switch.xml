<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ListView
        android:id="@+id/log_listview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/driver_log_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp">
        <TextView
            android:paddingTop="10dp"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:text="@string/wifi_log_switch_driver"/>
        <Spinner
            android:entries="@array/wifi_log_level_driver"
            android:id="@+id/driver_log_spinner"
            android:layout_width="320dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/fw_log_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp">
        <TextView
            android:paddingTop="10dp"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:text="@string/wifi_log_switch_fw"/>
        <Spinner
            android:entries="@array/wifi_log_level_driver"
            android:id="@+id/fw_log_spinner"
            android:layout_width="320dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
