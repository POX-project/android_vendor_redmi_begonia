<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/NetworkInfo_PageUp"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/NetworkInfo_PageUp"/>
        <Button
            android:id="@+id/NetworkInfo_PageDown"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="@string/NetworkInfo_PageDown"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/NetworkInfo_Info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </ScrollView>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/NetworkInfo_List_Header"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ListView
                android:id="@+id/NetworkInfo_List"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#ff303030"
                android:dividerHeight="1dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/NetworkInfo_tx"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/page_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:background="#ff909090"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/current_force_tx_ant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/current_force_tx_ant"/>
            <View
                android:background="#ff909090"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/current_tx_ant"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/current_tx_ant"/>
            <View
                android:background="#ff909090"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
            <TextView
                android:id="@+id/force_tx_ant_to"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/force_tx_ant_to"/>
            <RadioGroup
                android:gravity="left"
                android:orientation="vertical"
                android:id="@+id/tx_radio_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/tx_radio_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/force_tx_ant_radio0"/>
                <RadioButton
                    android:id="@+id/tx_radio_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/force_tx_ant_radio1"/>
            </RadioGroup>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:id="@+id/tx_set"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:text="@string/force_tx_ant_set"/>
                <Button
                    android:id="@+id/tx_enable"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:text="@string/force_tx_ant_disable"/>
            </LinearLayout>
            <View
                android:background="#ff909090"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
