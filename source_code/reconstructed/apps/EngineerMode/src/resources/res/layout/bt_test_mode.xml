<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/bt_ant_swap"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bt_tm_power_sel"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/bt_tm_power_rg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="10dp">
            <RadioButton
                android:id="@+id/bt_tm_power_default_rb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/bt_tm_power_default"
                android:layout_weight="1"/>
            <RadioButton
                android:id="@+id/bt_tm_power_cus_rb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bt_tm_power_cus"
                android:layout_weight="1"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bt_tm_power_ll"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bt_tm_power_power_input"/>
        <EditText
            android:id="@+id/bt_tm_power_et"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:maxLength="1"
            android:inputType="number"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:id="@+id/bt_tm_enable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bt_tm_enable"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bt_tm_disable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/bt_tm_disable"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
