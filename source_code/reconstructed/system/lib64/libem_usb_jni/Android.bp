// Android.bp for reverse-engineered libem_usb_jni.so
cc_library_shared {
    name: "libem_usb_jni_gki",
    vendor: true,
    srcs: [
        "libem_usb_jni.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libnativehelper",
        "libandroid_runtime",
        "libui",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
