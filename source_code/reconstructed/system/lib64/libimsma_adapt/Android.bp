// Android.bp for reverse-engineered libimsma_adapt.so
cc_library_shared {
    name: "libimsma_adapt",
    vendor: true,
    srcs: [
        "libimsma_adapt.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
