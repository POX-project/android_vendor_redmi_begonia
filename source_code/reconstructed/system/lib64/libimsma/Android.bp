// Android.bp for reverse-engineered libimsma.so
cc_library_shared {
    name: "libimsma",
    vendor: true,
    srcs: [
        "libimsma.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbinder",
        "libgui",
        "libmedia",
        "libstagefright",
        "libstagefright_foundation",
        "libui",
        "libsink-mtk",
        "libsource",
        "libvcodec_cap",
        "libimsma_rtp",
        "libcomutils",
        "libsignal",
        "libnetd_client",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
