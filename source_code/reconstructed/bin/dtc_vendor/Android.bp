// Android.bp for reverse-engineered dtc_vendor
cc_binary {
    name: "dtc_vendor_gki",
    vendor: true,
    srcs: [
        "dtc_vendor.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
