// Android.bp for reverse-engineered android.hardware.lights-service.mediatek
cc_binary {
    name: "android_hardware_lights_service_mediatek",
    vendor: true,
    srcs: [
        "android_hardware_lights_service_mediatek.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V1-ndk_platform",
        "libhardware_legacy",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
