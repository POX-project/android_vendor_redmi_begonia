// Android.bp for reverse-engineered camerahalserver
cc_binary {
    name: "camerahalserver",
    vendor: true,
    srcs: [
        "camerahalserver.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbinder",
        "libhwbinder",
        "libhidlbase",
        "libhidltransport",
        "libmtkcam_stdutils",
        "libmtkcam_ulog",
        "android.hardware.camera.provider@2.4",
        "vendor.mediatek.hardware.camera.lomoeffect@1.0",
        "vendor.mediatek.hardware.camera.ccap@1.0",
        "vendor.mediatek.hardware.camera.security@1.0",
        "vendor.mediatek.hardware.camera.frhandler@1.0",
        "vendor.mediatek.hardware.camera.postproc@1.0",
        "vendor.mediatek.hardware.camera.bgservice@1.0",
        "vendor.mediatek.hardware.camera.bgservice@1.1",
        "vendor.mediatek.hardware.camera.atms@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
