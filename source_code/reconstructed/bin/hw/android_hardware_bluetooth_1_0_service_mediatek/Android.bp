// Android.bp for reverse-engineered android.hardware.bluetooth@1.0-service-mediatek
cc_binary {
    name: "android_hardware_bluetooth_1_0_service_mediatek_gki",
    vendor: true,
    srcs: [
        "android_hardware_bluetooth_1_0_service_mediatek.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbase",
        "libhidlbase",
        "libhidltransport",
        "android.hardware.bluetooth@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
