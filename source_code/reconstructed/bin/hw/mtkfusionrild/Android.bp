// Android.bp for reverse-engineered mtkfusionrild
cc_binary {
    name: "mtkfusionrild_gki",
    vendor: true,
    srcs: [
        "mtkfusionrild.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libutils-v32",
        "libmtkrillog",
        "libmtkproperty",
        "libmtkcutils",
        "librilfusion",
        "libmtkrilutils",
        "libsysenv",
        "libmtkconfigutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
