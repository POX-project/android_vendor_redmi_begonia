// Android.bp for reverse-engineered audiocmdservice_atci
cc_binary {
    name: "audiocmdservice_atci",
    vendor: true,
    srcs: [
        "audiocmdservice_atci.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbinder",
        "libaudiocompensationfilter_vendor",
        "libaudioprimarydevicehalifclient",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
