// Android.bp for reverse-engineered md_monitor
cc_binary {
    name: "md_monitor",
    vendor: true,
    srcs: [
        "md_monitor.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc++",
        "libccci_util",
        "libselinux",
        "vendor.mediatek.hardware.mdmonitor@1.0",
        "libhidlbase",
        "libhidltransport",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
