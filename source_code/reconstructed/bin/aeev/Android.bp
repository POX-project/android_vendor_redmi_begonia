// Android.bp for reverse-engineered aeev
cc_binary {
    name: "aeev_gki",
    vendor: true,
    srcs: [
        "aeev.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libaedv",
        "libz",
        "libc",
        "libdl",
        "libm",
        "libc++",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
