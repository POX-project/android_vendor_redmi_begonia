// Android.bp for reverse-engineered mlipayd@1.1
cc_binary {
    name: "mlipayd_1_1_gki",
    vendor: true,
    srcs: [
        "mlipayd_1_1.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "vendor.xiaomi.hardware.mlipay@1.0",
        "libhidlbase",
        "libhidltransport",
        "vendor.xiaomi.hardware.mlipay@1.1",
        "libteeclientjni@1.1",
        "libmlipay@1.1",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
