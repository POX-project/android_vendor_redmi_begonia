// Android.bp for reverse-engineered factory
cc_binary {
    name: "factory_gki",
    vendor: true,
    srcs: [
        "factory.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libnvram",
        "libfile_op",
        "libcustom_nvram",
        "libminiui",
        "libjpeg",
        "libbase",
        "libfft_vendor",
        "libaudio_param_parser-vnd",
        "libselinux",
        "libalsautils",
        "libhardware_legacy",
        "libaudioutils",
        "libtinyalsa",
        "libtinycompress",
        "libtinyxml",
        "libaudiotoolkit_vendor",
        "libmedia_helper",
        "libladder",
        "vendor.mediatek.hardware.bluetooth.audio@2.1",
        "libhwm",
        "android.system.suspend@1.0",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "android.hardware.health@2.0",
        "android.hardware.light-V1-ndk_platform",
        "libbinder_ndk",
        "libbinder",
        "android.hardware.light@2.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
