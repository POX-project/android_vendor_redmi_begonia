// Android.bp for reverse-engineered toybox_vendor
cc_binary {
    name: "toybox_vendor",
    vendor: true,
    srcs: [
        "toybox_vendor.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcrypto",
        "libz",
        "libprocessgroup",
        "libselinux",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
