// Android.bp for reverse-engineered netdagent
cc_binary {
    name: "netdagent",
    vendor: true,
    srcs: [
        "netdagent.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libforkexecwrap",
        "libhwbinder",
        "libhidlbase",
        "libhidltransport",
        "libifcutils_mtk",
        "vendor.mediatek.hardware.netdagent@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
