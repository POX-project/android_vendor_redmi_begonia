// Android.bp for reverse-engineered em_hidl
cc_binary {
    name: "em_hidl_gki",
    vendor: true,
    srcs: [
        "em_hidl.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbase",
        "libbinder",
        "libhidlbase",
        "libhidltransport",
        "vendor.mediatek.hardware.engineermode@1.0",
        "vendor.mediatek.hardware.engineermode@1.1",
        "vendor.mediatek.hardware.engineermode@1.2",
        "vendor.mediatek.hardware.engineermode@1.3",
        "libbluetooth_relayer",
        "libbluetoothem_mtk",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
