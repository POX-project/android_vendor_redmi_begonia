// Android.bp for reverse-engineered vsimd
cc_binary {
    name: "vsimd_gki",
    vendor: true,
    srcs: [
        "vsimd.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "vendor.xiaomi.hardware.vsimapp@1.0",
        "libhidlbase",
        "libhidltransport",
        "libTEECommon",
        "libvsim",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
