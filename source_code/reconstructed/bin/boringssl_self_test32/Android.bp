// Android.bp for reverse-engineered boringssl_self_test32
cc_binary {
    name: "boringssl_self_test32",
    vendor: true,
    srcs: [
        "boringssl_self_test32.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcrypto",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
