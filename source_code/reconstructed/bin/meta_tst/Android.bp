// Android.bp for reverse-engineered meta_tst
cc_binary {
    name: "meta_tst",
    vendor: true,
    srcs: [
        "meta_tst.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libhardware_legacy",
        "libbase",
        "libhwm",
        "libccci_util",
        "libnetutils",
        "libselinux",
        "vendor.mediatek.hardware.nvram@1.1",
        "libnvram",
        "libfile_op",
        "libbinder",
        "libhidlbase",
        "libhidltransport",
        "vendor.mediatek.hardware.lbs@1.0",
        "libkmsetkey",
        "libsysenv",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
