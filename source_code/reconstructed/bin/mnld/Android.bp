// Android.bp for reverse-engineered mnld
cc_binary {
    name: "mnld_gki",
    vendor: true,
    srcs: [
        "mnld.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "android.hardware.sensors@1.0-convert-shared",
        "libmnl",
        "libcurl",
        "libnvram",
        "libcrypto",
        "libssl",
        "libz",
        "libladder",
        "libDR",
        "android.frameworks.sensorservice@1.0",
        "android.hardware.sensors@1.0",
        "libhidlbase",
        "libhidltransport",
        "libsensorndkbridge",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "bin/hw",
}
