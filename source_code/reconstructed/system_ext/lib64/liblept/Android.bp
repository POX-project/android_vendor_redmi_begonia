// Android.bp for reverse-engineered liblept.so
cc_library_shared {
    name: "liblept_gki",
    vendor: true,
    srcs: [
        "liblept.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libjpgt",
        "libpngt",
        "libz",
        "libjnigraphics",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
