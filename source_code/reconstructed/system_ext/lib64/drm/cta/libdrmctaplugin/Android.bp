// Android.bp for reverse-engineered libdrmctaplugin.so
cc_library_shared {
    name: "libdrmctaplugin",
    vendor: true,
    srcs: [
        "libdrmctaplugin.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libandroidicu",
        "libandroid_runtime",
        "libdrmmtkutil",
        "libcrypto",
        "libssl",
        "libbinder",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
