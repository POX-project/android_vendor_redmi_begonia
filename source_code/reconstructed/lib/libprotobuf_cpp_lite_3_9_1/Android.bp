// Android.bp for reverse-engineered libprotobuf-cpp-lite-3.9.1.so
cc_library_shared {
    name: "libprotobuf_cpp_lite_3_9_1_gki",
    vendor: true,
    srcs: [
        "libprotobuf_cpp_lite_3_9_1.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
