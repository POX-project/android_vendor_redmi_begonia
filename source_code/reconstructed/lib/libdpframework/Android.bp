// Android.bp for reverse-engineered libdpframework.so
cc_library_shared {
    name: "libdpframework_gki",
    vendor: true,
    srcs: [
        "libdpframework.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libhidlbase",
        "libhidlmemory",
        "vendor.mediatek.hardware.pq@2.0",
        "libion_mtk",
        "libgralloc_extra",
        "libpq_prot",
        "libion",
        "libsync",
        "libnativewindow",
        "libutilscallstack",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
