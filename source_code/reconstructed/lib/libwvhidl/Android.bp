// Android.bp for reverse-engineered libwvhidl.so
cc_library_shared {
    name: "libwvhidl_gki",
    vendor: true,
    srcs: [
        "libwvhidl.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "android.hardware.drm@1.0",
        "android.hardware.drm@1.1",
        "android.hardware.drm@1.2",
        "android.hardware.drm@1.3",
        "android.hidl.memory@1.0",
        "libbase",
        "libcrypto-v33",
        "libhidlbase",
        "libhidlmemory",
        "libprotobuf-cpp-lite-3.9.1",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
