// Android.bp for reverse-engineered libhwc2on1adapter.so
cc_library_shared {
    name: "libhwc2on1adapter_gki",
    vendor: true,
    srcs: [
        "libhwc2on1adapter.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
