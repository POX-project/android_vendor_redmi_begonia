// Android.bp for reverse-engineered libteeclientjni@1.1.so
cc_library_shared {
    name: "libteeclientjni_1_1",
    vendor: true,
    srcs: [
        "libteeclientjni_1_1.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libTEECommon",
        "libimsg_log",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
