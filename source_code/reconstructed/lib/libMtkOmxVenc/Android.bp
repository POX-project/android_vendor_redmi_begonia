// Android.bp for reverse-engineered libMtkOmxVenc.so
cc_library_shared {
    name: "libMtkOmxVenc_gki",
    vendor: true,
    srcs: [
        "libMtkOmxVenc.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbinder",
        "libui",
        "libion",
        "libion_mtk",
        "libgralloc_extra",
        "android.hardware.media@1.0",
        "android.hardware.media.omx@1.0",
        "libbwc",
        "android.hardware.graphics.common@1.2",
        "libvcodecdrv",
        "libvcodec_utility",
        "libdpframework",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
