// Android.bp for reverse-engineered libwo.so
cc_library_shared {
    name: "libwo_gki",
    vendor: true,
    srcs: [
        "libwo.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc",
        "libdl",
        "libm",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
