// Android.bp for reverse-engineered libbluetooth_mtk_pure.so
cc_library_shared {
    name: "libbluetooth_mtk_pure_gki",
    vendor: true,
    srcs: [
        "libbluetooth_mtk_pure.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libnvram",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
