// Android.bp for reverse-engineered gc2375beta_mipi_raw_IdxMgr.so
cc_library_shared {
    name: "gc2375beta_mipi_raw_IdxMgr_gki",
    vendor: true,
    srcs: [
        "gc2375beta_mipi_raw_IdxMgr.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
