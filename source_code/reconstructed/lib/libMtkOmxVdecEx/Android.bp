    name: "libMtkOmxVdecEx_gki",
    vendor: true,
    srcs: [
        "libMtkOmxVdecEx.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libui_shim",
        "libui",
        "libion",
        "libged",
        "libion_mtk",
        "libsync",
        "android.hardware.graphics.common@1.2",
        "libdpframework",
        "libgralloc_extra",
        "libvcodecdrv",
        "libvcodec_utility",
        "vendor.mediatek.hardware.pq@2.5",
        "libbinder",
        "libhidlbase",
        "libhidltransport",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
