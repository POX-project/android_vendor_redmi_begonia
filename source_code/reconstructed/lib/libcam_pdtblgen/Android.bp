// Android.bp for reverse-engineered libcam.pdtblgen.so
cc_library_shared {
    name: "libcam_pdtblgen_gki",
    vendor: true,
    srcs: [
        "libcam_pdtblgen.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libcam.iopipe",
        "libmtkcam_modulehelper",
        "libcameracustom",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
