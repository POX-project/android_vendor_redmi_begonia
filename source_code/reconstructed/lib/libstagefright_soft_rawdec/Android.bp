// Android.bp for reverse-engineered libstagefright_soft_rawdec.so
cc_library_shared {
    name: "libstagefright_soft_rawdec",
    vendor: true,
    srcs: [
        "libstagefright_soft_rawdec.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libstagefright_softomx",
        "libstagefright_foundation",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
