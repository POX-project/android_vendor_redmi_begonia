// Android.bp for reverse-engineered libcam.iopipe.so
cc_library_shared {
    name: "libcam_iopipe",
    vendor: true,
    srcs: [
        "libcam_iopipe.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libaedv",
        "libimageio_plat_drv",
        "libimageio_plat_pipe",
        "libdip_postproc",
        "libmtkcam_tuning_utils",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_metadata",
        "libcam.halsensor",
        "libimageio",
        "libcamdrv_isp",
        "libcamdrv_imem",
        "libdpframework",
        "libJpgEncPipe",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
