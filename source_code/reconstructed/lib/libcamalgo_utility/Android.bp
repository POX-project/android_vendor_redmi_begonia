// Android.bp for reverse-engineered libcamalgo.utility.so
cc_library_shared {
    name: "libcamalgo_utility_gki",
    vendor: true,
    srcs: [
        "libcamalgo_utility.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libEGL",
        "libGLESv2",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
