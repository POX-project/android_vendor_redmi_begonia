// Android.bp for reverse-engineered libaudiosmartpamtk.so
cc_library_shared {
    name: "libaudiosmartpamtk",
    vendor: true,
    srcs: [
        "libaudiosmartpamtk.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libnvram",
        "libtinyalsa",
        "libcrypto",
        "libssl",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
