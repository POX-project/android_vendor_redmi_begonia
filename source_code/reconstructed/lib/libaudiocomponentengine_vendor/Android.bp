// Android.bp for reverse-engineered libaudiocomponentengine_vendor.so
cc_library_shared {
    name: "libaudiocomponentengine_vendor_gki",
    vendor: true,
    srcs: [
        "libaudiocomponentengine_vendor.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libaudiodcrflt_vendor",
        "libblisrc32_vendor",
        "libmtklimiter_vendor",
        "libmtkshifter_vendor",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
