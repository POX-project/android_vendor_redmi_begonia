// Android.bp for reverse-engineered libeffectsconfig.so
cc_library_shared {
    name: "libeffectsconfig",
    vendor: true,
    srcs: [
        "libeffectsconfig.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libtinyxml2",
        "libmedia_helper",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
