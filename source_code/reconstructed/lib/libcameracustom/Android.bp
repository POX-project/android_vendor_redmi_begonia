// Android.bp for reverse-engineered libcameracustom.so
cc_library_shared {
    name: "libcameracustom_gki",
    vendor: true,
    srcs: [
        "libcameracustom.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libaedv",
        "libcam.hal3a.log",
        "libmtkcam_stdutils",
        "libSonyIMX230PdafLibraryWrapper",
        "libSonyIMX386PdafLibraryWrapper",
        "libSonyIMX338PdafLibraryWrapper",
        "libSonyIMX519PdafLibraryWrapper",
        "s5kgw1sunny_mipi_raw_IdxMgr",
        "s5kgw1ofilm_mipi_raw_IdxMgr",
        "s5k3t2_mipi_raw_IdxMgr",
        "s5k3t1sunny_mipi_raw_IdxMgr",
        "s5k3t1ofilm_mipi_raw_IdxMgr",
        "ov02a10af_mipi_raw_IdxMgr",
        "gc2375af_mipi_raw_IdxMgr",
        "gc5035_mipi_raw_IdxMgr",
        "gc2375beta_mipi_raw_IdxMgr",
        "gc2375alpha_mipi_raw_IdxMgr",
        "ov02a10beta_mipi_raw_IdxMgr",
        "ov02a10alpha_mipi_raw_IdxMgr",
        "ov8856sunny_mipi_raw_IdxMgr",
        "ov8856ofilm_mipi_raw_IdxMgr",
        "libmtkcam_modulehelper",
        "libcam.ArcCamEngine",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
