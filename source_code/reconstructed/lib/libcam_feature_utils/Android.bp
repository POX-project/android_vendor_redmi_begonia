// Android.bp for reverse-engineered libcam.feature_utils.so
cc_library_shared {
    name: "libcam_feature_utils_gki",
    vendor: true,
    srcs: [
        "libcam_feature_utils.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libdpframework",
        "libcam.iopipe",
        "libmtkcam_exif",
        "libmtkcam_modulehelper",
        "libmtkcam_tuning_utils",
        "libmtkcam_mapping_mgr",
        "libaedv",
        "libdip_postproc",
        "libcam.halsensor",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
