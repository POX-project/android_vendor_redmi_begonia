// Android.bp for reverse-engineered libstrongswan.so
cc_library_shared {
    name: "libstrongswan_gki",
    vendor: true,
    srcs: [
        "libstrongswan.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libssl-ss",
        "libcurl-ss",
        "libcrypto-ss",
        "libdl",
        "libc",
        "libm",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
