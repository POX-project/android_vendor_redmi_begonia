// Android.bp for reverse-engineered ls_client.so
cc_library_shared {
    name: "ls_client_gki",
    vendor: true,
    srcs: [
        "ls_client.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbase",
        "libchrome",
        "libhidlbase",
        "se_extn_client",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
