// Android.bp for reverse-engineered libril.so
cc_library_shared {
    name: "libril_gki",
    vendor: true,
    srcs: [
        "libril.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libhardware_legacy",
        "librilutils",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio.deprecated@1.0",
        "libhidlbase",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
