// Android.bp for reverse-engineered libfpspolicy.so
cc_library_shared {
    name: "libfpspolicy",
    vendor: true,
    srcs: [
        "libfpspolicy.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "vendor.mediatek.hardware.dfps@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
