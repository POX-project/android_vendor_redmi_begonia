// Android.bp for reverse-engineered libaudio_param_parser-vnd.so
cc_library_shared {
    name: "libaudio_param_parser_vnd",
    vendor: true,
    srcs: [
        "libaudio_param_parser_vnd.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbinder",
        "libaudiocustparam_vendor",
        "libaudioprimarydevicehalifclient",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
