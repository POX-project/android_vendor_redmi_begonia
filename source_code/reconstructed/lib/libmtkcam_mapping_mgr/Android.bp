// Android.bp for reverse-engineered libmtkcam_mapping_mgr.so
cc_library_shared {
    name: "libmtkcam_mapping_mgr",
    vendor: true,
    srcs: [
        "libmtkcam_mapping_mgr.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_debugutils",
        "libmtkcam_grallocutils",
        "libmtkcam_sysutils",
        "libaedv",
        "libcam.hal3a.v3.nvram.50",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
