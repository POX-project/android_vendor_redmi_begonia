// Android.bp for reverse-engineered libsensorndkbridge.so
cc_library_shared {
    name: "libsensorndkbridge_gki",
    vendor: true,
    srcs: [
        "libsensorndkbridge.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libbase",
        "libhidlbase",
        "android.frameworks.sensorservice@1.0",
        "android.hardware.sensors@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
