// Android.bp for reverse-engineered libgz_gp_client.so
cc_library_shared {
    name: "libgz_gp_client",
    vendor: true,
    srcs: [
        "libgz_gp_client.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libgz_uree",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
