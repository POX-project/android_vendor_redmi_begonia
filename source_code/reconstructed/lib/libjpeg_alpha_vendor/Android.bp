// Android.bp for reverse-engineered libjpeg-alpha_vendor.so
cc_library_shared {
    name: "libjpeg_alpha_vendor",
    vendor: true,
    srcs: [
        "libjpeg_alpha_vendor.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libjpeg-alpha-oal_vendor",
        "libc++",
        "libdl",
        "libc",
        "libm",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
