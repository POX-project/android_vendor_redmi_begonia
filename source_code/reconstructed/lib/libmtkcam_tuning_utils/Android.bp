// Android.bp for reverse-engineered libmtkcam_tuning_utils.so
cc_library_shared {
    name: "libmtkcam_tuning_utils",
    vendor: true,
    srcs: [
        "libmtkcam_tuning_utils.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_modulehelper",
        "libmtkcam_metadata",
        "libmtkcam_stdutils",
        "libmtkcam_sysutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
