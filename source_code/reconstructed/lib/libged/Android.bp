// Android.bp for reverse-engineered libged.so
cc_library_shared {
    name: "libged_gki",
    vendor: true,
    srcs: [
        "libged.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libsync",
        "libnativewindow",
        "libhidlbase",
        "vendor.mediatek.hardware.gpu@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
