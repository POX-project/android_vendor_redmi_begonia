// Android.bp for reverse-engineered libcam.hal3a.v3.so
cc_library_shared {
    name: "libcam_hal3a_v3",
    vendor: true,
    srcs: [
        "libcam_hal3a_v3.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "lib3a.ccudrv",
        "lib3a.ccuif",
        "libion",
        "libion_mtk",
        "lib3a.n3d3a",
        "libcamalgo.ispfeature",
        "libcamalgo.utility",
        "libladder",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_hwutils",
        "lib3a.gma",
        "lib3a.lce",
        "libcamalgo.lsc",
        "libcamalgo.flicker",
        "libcam3a_imem",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmtkcam_sysutils",
        "libcam.pdtblgen",
        "vendor.mediatek.hardware.camera.atms@1.0",
        "libcam.iopipe",
        "libcam.hal3a.v3.nvram.50",
        "libcam.hal3a.v3.lsctbl.50",
        "libcam.hal3a.v3.lscMgr",
        "libcamdrv_tuning_mgr",
        "libcam.utils.sensorprovider",
        "libui",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "android.hardware.power@1.0",
        "vendor.mediatek.hardware.power@2.0",
        "vendor.mediatek.hardware.mtkpower@1.0",
        "libcamalgo.vpunr",
        "libaedv",
        "libmtkcam_tuning_utils",
        "libmtkcam_mapping_mgr",
        "libmtkcam.atmseventmgr",
        "libcameracustom",
        "lib3a.af.core",
        "lib3a.af",
        "lib3a.awb",
        "lib3a.awb.core",
        "lib3a.flash",
        "lib3a.ae",
        "lib3a.ae.core",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
