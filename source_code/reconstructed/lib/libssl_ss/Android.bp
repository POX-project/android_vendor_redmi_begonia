// Android.bp for reverse-engineered libssl-ss.so
cc_library_shared {
    name: "libssl_ss",
    vendor: true,
    srcs: [
        "libssl_ss.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcrypto-ss",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
