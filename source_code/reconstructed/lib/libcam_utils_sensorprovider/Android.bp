// Android.bp for reverse-engineered libcam.utils.sensorprovider.so
cc_library_shared {
    name: "libcam_utils_sensorprovider_gki",
    vendor: true,
    srcs: [
        "libcam_utils_sensorprovider.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "android.hardware.sensors@1.0-convert-shared",
        "libmtkcam_stdutils",
        "android.frameworks.sensorservice@1.0",
        "android.hardware.sensors@1.0",
        "libhidlbase",
        "libhidltransport",
        "libsensorndkbridge",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
