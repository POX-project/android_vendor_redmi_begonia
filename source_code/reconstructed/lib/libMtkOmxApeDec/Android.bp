// Android.bp for reverse-engineered libMtkOmxApeDec.so
cc_library_shared {
    name: "libMtkOmxApeDec_gki",
    vendor: true,
    srcs: [
        "libMtkOmxApeDec.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libui",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "libhidlmemory",
        "vendor.mediatek.hardware.mtkcodecservice@1.1",
        "android.hidl.allocator@1.0",
        "android.hidl.memory@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
