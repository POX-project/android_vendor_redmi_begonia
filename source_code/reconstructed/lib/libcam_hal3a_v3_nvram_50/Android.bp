// Android.bp for reverse-engineered libcam.hal3a.v3.nvram.50.so
cc_library_shared {
    name: "libcam_hal3a_v3_nvram_50",
    vendor: true,
    srcs: [
        "libcam_hal3a_v3_nvram_50.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_modulehelper",
        "libbinder",
        "libaedv",
        "libcameracustom",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
