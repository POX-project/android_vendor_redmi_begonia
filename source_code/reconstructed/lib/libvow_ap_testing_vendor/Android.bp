// Android.bp for reverse-engineered libvow_ap_testing.vendor.so
cc_library_shared {
    name: "libvow_ap_testing_vendor_gki",
    vendor: true,
    srcs: [
        "libvow_ap_testing_vendor.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libvowp2training.vendor",
        "libvowp23_sid_training.vendor",
        "libvowp23_sid_testing.vendor",
        "libvowp25testing.vendor",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
