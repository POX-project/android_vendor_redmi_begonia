// Android.bp for reverse-engineered libchromanr.so
cc_library_shared {
    name: "libchromanr_gki",
    vendor: true,
    srcs: [
        "libchromanr.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcam.hal3a.v3",
        "libmtkcam_mapping_mgr",
        "lib3a.awb.core",
        "lib3a.ae.core",
        "lib3a.af.core",
        "lib3a.flash",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libcameracustom",
        "libmtkcam_modulehelper",
        "libcam.iopipe",
        "libcam.feature_utils",
        "libmtkcam_metadata",
        "libmtkcam_tuning_utils",
        "libmtkcam_exif",
        "libmtkcam_grallocutils",
        "libmtkcam_streamutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
