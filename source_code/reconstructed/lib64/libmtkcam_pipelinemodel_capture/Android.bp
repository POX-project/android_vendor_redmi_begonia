// Android.bp for reverse-engineered libmtkcam_pipelinemodel_capture.so
cc_library_shared {
    name: "libmtkcam_pipelinemodel_capture",
    vendor: true,
    srcs: [
        "libmtkcam_pipelinemodel_capture.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_metadata",
        "libmtkcam_hwutils",
        "libmtkcam_streamutils",
        "libmtkcam_pipeline",
        "libmtkcam_prerelease",
        "libmtkcam_sysutils",
        "libmtkcam_pipelinemodel_utils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
