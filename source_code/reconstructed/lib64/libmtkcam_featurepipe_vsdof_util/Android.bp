// Android.bp for reverse-engineered libmtkcam.featurepipe.vsdof_util.so
cc_library_shared {
    name: "libmtkcam_featurepipe_vsdof_util_gki",
    vendor: true,
    srcs: [
        "libmtkcam_featurepipe_vsdof_util.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_ulog",
        "libgralloc_extra",
        "libeffecthal.base",
        "libcam.iopipe",
        "libion",
        "libion_mtk",
        "libdpframework",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
