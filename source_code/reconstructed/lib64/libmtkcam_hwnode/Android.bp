// Android.bp for reverse-engineered libmtkcam_hwnode.so
cc_library_shared {
    name: "libmtkcam_hwnode_gki",
    vendor: true,
    srcs: [
        "libmtkcam_hwnode.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libgralloc_extra",
        "android.hardware.camera.device@3.2",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_ulog",
        "libmtkcam_grallocutils",
        "libmtkcam_imgbuf",
        "libmtkcam_streamutils",
        "libmtkcam_hwutils",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmtkcam_prerelease",
        "libcam.feature_utils",
        "libcameracustom",
        "libcameracustom.eis",
        "libcam.utils.sensorprovider",
        "libcam.iopipe",
        "libfeature_lmv",
        "libfeature_eis",
        "libfeature_3dnr",
        "libfeature_rss",
        "libfeature_fsc",
        "libion_mtk",
        "libion",
        "libaedv",
        "libladder",
        "libmtkcam_exif",
        "libstereoinfoaccessor_vsdof",
        "libmtkcam_sysutils",
        "libcam.vhdr",
        "libmfllcore",
        "libcamalgo.dngop",
        "libfeature.face",
        "libdpframework",
        "libmtkcam_tuning_utils",
        "libmtkcam_mapping_mgr",
        "libmtkcam.featurepipe.streaming",
        "libmtkcam.featurepipe.capture",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
