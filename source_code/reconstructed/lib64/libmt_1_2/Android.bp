// Android.bp for reverse-engineered libmt@1.2.so
cc_library_shared {
    name: "libmt_1_2",
    vendor: true,
    srcs: [
        "libmt_1_2.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "vendor.xiaomi.hardware.mtdservice@1.0",
        "vendor.xiaomi.hardware.mtdservice@1.1",
        "vendor.xiaomi.hardware.mtdservice@1.2",
        "libhidlbase",
        "libhidltransport",
        "libTEECommon",
        "libselinux",
        "libmlipay@1.1",
        "vendor.xiaomi.hardware.mlipay@1.1",
        "libmfido",
        "vendor.xiaomi.hardware.mfidoca@1.0",
        "libcrypto",
        "wechat.beanpod",
        "libxml2",
        "libwvkeybox",
        "liboemcrypto",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
