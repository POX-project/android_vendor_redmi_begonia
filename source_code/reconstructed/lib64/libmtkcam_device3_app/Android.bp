// Android.bp for reverse-engineered libmtkcam_device3_app.so
cc_library_shared {
    name: "libmtkcam_device3_app_gki",
    vendor: true,
    srcs: [
        "libmtkcam_device3_app.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libhidlbase",
        "libfmq",
        "android.hardware.camera.device@3.2",
        "android.hardware.camera.device@3.3",
        "android.hardware.camera.device@3.4",
        "libmtkcam_stdutils",
        "libmtkcam_ulog",
        "libmtkcam_metadata",
        "libmtkcam_debugutils",
        "libmtkcam_grallocutils",
        "libmtkcam_imgbuf",
        "libmtkcam_streamutils",
        "libnativewindow",
        "libmtkcam_metastore",
        "libmtkcam_modulehelper",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
