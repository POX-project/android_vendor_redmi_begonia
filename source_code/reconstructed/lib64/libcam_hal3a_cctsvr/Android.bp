// Android.bp for reverse-engineered libcam.hal3a.cctsvr.so
cc_library_shared {
    name: "libcam_hal3a_cctsvr_gki",
    vendor: true,
    srcs: [
        "libcam_hal3a_cctsvr.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc++",
        "libbinder",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_fwkutils",
        "libmtkcam_metadata",
        "libcam.iopipe",
        "libcamdrv_imem",
        "libcam.hal3a.v3",
        "libcam.hal3a.v3.nvram.50",
        "libcam.hal3a.v3.lsctbl.50",
        "libcam.hal3a.v3.lscMgr",
        "libcamalgo.lsc",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
