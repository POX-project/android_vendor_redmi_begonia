// Android.bp for reverse-engineered libfeature.vsdof.hal.so
cc_library_shared {
    name: "libfeature_vsdof_hal_gki",
    vendor: true,
    srcs: [
        "libfeature_vsdof_hal.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcamalgo.n3d",
        "libcamalgo.vsf",
        "libabfadp",
        "libnativewindow",
        "liblz4",
        "libcam.ArcCamEngine",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libnvram",
        "libcameracustom",
        "libdpframework",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libgralloc_extra",
        "libcam.iopipe",
        "libsync",
        "libfeature.stereo.provider",
        "libmtkcam_tuning_utils",
        "libmtkcam_hwutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
