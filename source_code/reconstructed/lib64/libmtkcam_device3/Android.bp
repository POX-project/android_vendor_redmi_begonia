// Android.bp for reverse-engineered libmtkcam_device3.so
cc_library_shared {
    name: "libmtkcam_device3",
    vendor: true,
    srcs: [
        "libmtkcam_device3.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libladder",
        "libhidlbase",
        "libhidltransport",
        "android.hardware.camera.device@3.2",
        "android.hardware.camera.device@3.3",
        "android.hardware.camera.device@3.4",
        "libmtkcam_sysutils",
        "libmtkcam_stdutils",
        "libmtkcam_ulog",
        "libmtkcam_debugutils",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmtkcam_modulehelper",
        "libmtkcam_device3_app",
        "libmtkcam_pipelinemodel",
        "android.hardware.power@1.0",
        "vendor.mediatek.hardware.power@2.0",
        "libmtkcam_hwutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
