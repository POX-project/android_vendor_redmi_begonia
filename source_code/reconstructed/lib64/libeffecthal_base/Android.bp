// Android.bp for reverse-engineered libeffecthal.base.so
cc_library_shared {
    name: "libeffecthal_base_gki",
    vendor: true,
    srcs: [
        "libeffecthal_base.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libui-v34",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libcameracustom",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
