// Android.bp for reverse-engineered libmtkcam_3rdparty.customer.so
cc_library_shared {
    name: "libmtkcam_3rdparty_customer",
    vendor: true,
    srcs: [
        "libmtkcam_3rdparty_customer.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_imgbuf",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmtkcam_stdutils",
        "libmtkcam_3rdparty.core",
        "libmpbase",
        "libcam.ArcCamEngine",
        "libfeature.stereo.provider",
        "libarcsoft_dualcam_refocus",
        "libcam.utils.sensorprovider",
        "libarcsoft_beautyshot",
        "libmtkcam_hwutils",
        "libalLDC",
        "libalhLDC",
        "libalRnBRT_GL_GBWRAPPER",
        "libcam.iopipe",
        "libarcsoft_preview_deflicker",
        "libapu-frontend",
        "libapu-platform",
        "libmibokeh_mt6785",
        "libmtkcam_modulehelper",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
