// Android.bp for reverse-engineered libmtkcam_modulefactory_aaa.so
cc_library_shared {
    name: "libmtkcam_modulefactory_aaa_gki",
    vendor: true,
    srcs: [
        "libmtkcam_modulefactory_aaa.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcam.hal3a.v3",
        "libcam.hal3a.v3.dng",
        "libcam.hal3a.v3.lsctbl.50",
        "libcam.hal3a.v3.nvram.50",
        "libcam.halisp",
        "libcam.lcs",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
