// Android.bp for reverse-engineered libapu-platform.so
cc_library_shared {
    name: "libapu_platform_gki",
    vendor: true,
    srcs: [
        "libapu_platform.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libdl",
        "libz",
        "libm",
        "libc",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
