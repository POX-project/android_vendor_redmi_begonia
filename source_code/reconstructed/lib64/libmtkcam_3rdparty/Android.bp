// Android.bp for reverse-engineered libmtkcam_3rdparty.so
cc_library_shared {
    name: "libmtkcam_3rdparty_gki",
    vendor: true,
    srcs: [
        "libmtkcam_3rdparty.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_3rdparty.core",
        "libmtkcam_3rdparty.mtk",
        "libmtkcam_3rdparty.customer",
        "libmtkcam_3rdparty.vidhance",
        "libmtkcam_stdutils",
        "libmtkcam_metadata",
        "libmfllcore",
        "libcam.hal3a.v3",
        "libcam.feature_utils",
        "libmtkcam_modulehelper",
        "libmtkcam_hwutils",
        "libcamalgo.dngop",
        "libmtkcam_imgbuf",
        "libmtkcam_tuning_utils",
        "libcam.iopipe",
        "libmtkcam_mapping_mgr",
        "libcameracustom",
        "libdpframework",
        "libmtkcam.featurepipe.vsdof_util",
        "libfeature.stereo.provider",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
