// Android.bp for reverse-engineered libkeystore-engine-wifi-hidl.so
cc_library_shared {
    name: "libkeystore_engine_wifi_hidl",
    vendor: true,
    srcs: [
        "libkeystore_engine_wifi_hidl.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "android.system.wifi.keystore@1.0",
        "libcrypto",
        "libhidlbase",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
