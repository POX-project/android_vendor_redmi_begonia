// Android.bp for reverse-engineered libmtkcam.featurepipe.depthmap.so
cc_library_shared {
    name: "libmtkcam_featurepipe_depthmap",
    vendor: true,
    srcs: [
        "libmtkcam_featurepipe_depthmap.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libnativewindow",
        "libmtkcam_modulehelper",
        "libcam.iopipe",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_ulog",
        "libfeature.vsdof.hal",
        "libfeature.stereo.provider",
        "libeffecthal.base",
        "libgralloc_extra",
        "libfeature.face",
        "libmtkcam_metadata",
        "libmtkcam.featurepipe.vsdof_util",
        "libcameracustom",
        "libmtkcam_dpe",
        "libmtkcam_owe",
        "libfeature_3dnr",
        "libJpgEncPipe",
        "libmtkcam_exif",
        "libsync",
        "libdpframework",
        "libion",
        "libion_mtk",
        "libmtkcam_tuning_utils",
        "libaedv",
        "libcam.feature_utils",
        "libladder",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
