// Android.bp for reverse-engineered libkeymaster4support.so
cc_library_shared {
    name: "libkeymaster4support_gki",
    vendor: true,
    srcs: [
        "libkeymaster4support.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "android.hardware.keymaster@3.0",
        "android.hardware.keymaster@4.0",
        "libbase",
        "libcrypto",
        "libhidlbase",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
