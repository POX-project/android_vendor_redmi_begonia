// Android.bp for reverse-engineered libc++_shared.so
cc_library_shared {
    name: "libc++_shared",
    vendor: true,
    srcs: [
        "libc++_shared.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libc",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
