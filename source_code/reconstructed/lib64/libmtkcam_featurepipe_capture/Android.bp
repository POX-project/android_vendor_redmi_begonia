// Android.bp for reverse-engineered libmtkcam.featurepipe.capture.so
cc_library_shared {
    name: "libmtkcam_featurepipe_capture_gki",
    vendor: true,
    srcs: [
        "libmtkcam_featurepipe_capture.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libladder",
        "libnativewindow",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_ulog",
        "libcam.iopipe",
        "libdpframework",
        "libgralloc_extra",
        "libcameracustom",
        "libmtkcam_tuning_utils",
        "libmtkcam_metadata",
        "libcamalgo.dngop",
        "libmtkcam_debugutils",
        "libmtkcam_hwutils",
        "libfeature.face",
        "libhidlbase",
        "vendor.mediatek.hardware.power@2.0",
        "libmfllcore",
        "libcamalgo.mfnr",
        "libmtkcam_exif",
        "libmtkcam.featurepipe.vsdof_util",
        "libmtkcam_metastore",
        "libmtkcam_3rdparty",
        "libmtkcam_3rdparty.core",
        "libmtkcam_mapping_mgr",
        "libfeature.stereo.provider",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
