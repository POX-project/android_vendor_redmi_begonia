// Android.bp for reverse-engineered libmtkcam_3rdparty.vidhance.so
cc_library_shared {
    name: "libmtkcam_3rdparty_vidhance_gki",
    vendor: true,
    srcs: [
        "libmtkcam_3rdparty_vidhance.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_imgbuf",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmtkcam_stdutils",
        "libmtkcam_3rdparty.core",
        "libvidhance",
        "libmtkcam_pipeline",
        "libmtkcam_streamutils",
        "libui-v34",
        "libnativewindow",
        "libhidlbase",
        "libhidltransport",
        "android.frameworks.sensorservice@1.0",
        "libmtkcam_modulehelper",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
