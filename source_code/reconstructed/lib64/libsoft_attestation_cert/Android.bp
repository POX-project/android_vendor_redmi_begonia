// Android.bp for reverse-engineered libsoft_attestation_cert.so
cc_library_shared {
    name: "libsoft_attestation_cert_gki",
    vendor: true,
    srcs: [
        "libsoft_attestation_cert.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libkeymaster_portable",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
