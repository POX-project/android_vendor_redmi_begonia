// Android.bp for reverse-engineered libmtkcam_pipeline.so
cc_library_shared {
    name: "libmtkcam_pipeline_gki",
    vendor: true,
    srcs: [
        "libmtkcam_pipeline.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libaedv",
        "libmtkcam_stdutils",
        "libmtkcam_debugutils",
        "libmtkcam_ulog",
        "libmtkcam_metadata",
        "libmtkcam_streamutils",
        "libmtkcam_prerelease",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
