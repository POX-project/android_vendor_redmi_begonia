// Android.bp for reverse-engineered libkeymaster4.so
cc_library_shared {
    name: "libkeymaster4",
    vendor: true,
    srcs: [
        "libkeymaster4.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libkeymaster_messages",
        "android.hardware.keymaster@4.0",
        "libcrypto",
        "libbase",
        "libhidlbase",
        "libkeymaster_portable",
        "libpuresoftkeymasterdevice",
        "libkeymaster4support",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
