// Android.bp for reverse-engineered libmtk-ril.so
cc_library_shared {
    name: "libmtk_ril_gki",
    vendor: true,
    srcs: [
        "libmtk_ril.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkutils",
        "librilfusion",
        "libmtknetutils",
        "libratconfig",
        "libmtksysutils",
        "libmtkhardware_legacy",
        "libsysenv",
        "libmtkrilutils",
        "libcrypto",
        "libmtkcutils",
        "libmtkproperty",
        "libmtkrillog",
        "libmtkconfigutils",
        "libmtktinyxml",
        "libmtkares",
        "libnvram",
        "vendor.mediatek.hardware.nvram@1.1",
        "libbinder",
        "libhidlbase",
        "libhidltransport",
        "libaedv",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
