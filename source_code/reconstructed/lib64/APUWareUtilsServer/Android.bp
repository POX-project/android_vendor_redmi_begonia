// Android.bp for reverse-engineered APUWareUtilsServer.so
cc_library_shared {
    name: "APUWareUtilsServer_gki",
    vendor: true,
    srcs: [
        "APUWareUtilsServer.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libhidlbase",
        "vendor.mediatek.hardware.apuware.utils@1.0",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
