// Android.bp for reverse-engineered libmialgoengine.so
cc_library_shared {
    name: "libmialgoengine",
    vendor: true,
    srcs: [
        "libmialgoengine.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libnativewindow",
        "libEGL",
        "libGLESv2",
        "libmpbase",
        "libarcsoft_beautyshot",
        "libarcsoft_dualcam_refocus",
        "libarcsoft_portrait_lighting",
        "libarcsoft_portrait_lighting_c",
        "libarcsoft_low_light_hdr",
        "libarcsoft_high_dynamic_range",
        "libVDSuperPhotoAPI",
        "libalhLDC",
        "libalCFR",
        "libmibokeh_mt6785",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
