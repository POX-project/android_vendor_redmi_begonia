// Android.bp for reverse-engineered libcam.hal3a.v3.dng.so
cc_library_shared {
    name: "libcam_hal3a_v3_dng",
    vendor: true,
    srcs: [
        "libcam_hal3a_v3_dng.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcam.hal3a.v3.nvram.50",
        "libcam.hal3a.v3.lsctbl.50",
        "libmtkcam_modulehelper",
        "libmtkcam_metadata",
        "libmtkcam_stdutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
