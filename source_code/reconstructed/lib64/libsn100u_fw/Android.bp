// Android.bp for reverse-engineered libsn100u_fw.so
cc_library_shared {
    name: "libsn100u_fw_gki",
    vendor: true,
    srcs: [
        "libsn100u_fw.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
