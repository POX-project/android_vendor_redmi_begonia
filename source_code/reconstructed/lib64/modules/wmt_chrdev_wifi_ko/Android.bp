// Android.bp for reverse-engineered wmt_chrdev_wifi.ko
cc_library_shared {
    name: "wmt_chrdev_wifi_ko_gki",
    vendor: true,
    srcs: [
        "wmt_chrdev_wifi_ko.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
