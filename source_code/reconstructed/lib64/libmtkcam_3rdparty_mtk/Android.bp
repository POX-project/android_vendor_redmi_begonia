// Android.bp for reverse-engineered libmtkcam_3rdparty.mtk.so
cc_library_shared {
    name: "libmtkcam_3rdparty_mtk_gki",
    vendor: true,
    srcs: [
        "libmtkcam_3rdparty_mtk.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libutilscallstack",
        "libmtkcam_stdutils",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmfllcore",
        "libcam.hal3a.v3",
        "libcam.feature_utils",
        "libmtkcam_modulehelper",
        "libmtkcam_hwutils",
        "libmtkcam_exif",
        "libcamalgo.dngop",
        "libmtkcam_imgbuf",
        "libmtkcam_3rdparty.core",
        "libmpbase",
        "libarcsoft_dualcam_refocus",
        "libarcsoft_beautyshot",
        "libcam.ArcCamEngine",
        "libmtkcam_tuning_utils",
        "libarcsoft_high_dynamic_range",
        "libarcsoft_low_light_hdr",
        "libcam.iopipe",
        "libmtkcam_mapping_mgr",
        "libcameracustom",
        "libdpframework",
        "libmtkcam.featurepipe.vsdof_util",
        "libfeature.stereo.provider",
        "liblpcnr",
        "libmtkcam.featurepipe.depthmap",
        "libmialgo_sd",
        "libcamera_scene",
        "libc++_shared",
        "libcam.utils.sensorprovider",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
