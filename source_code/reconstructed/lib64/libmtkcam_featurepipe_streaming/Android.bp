// Android.bp for reverse-engineered libmtkcam.featurepipe.streaming.so
cc_library_shared {
    name: "libmtkcam_featurepipe_streaming_gki",
    vendor: true,
    srcs: [
        "libmtkcam_featurepipe_streaming.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libladder",
        "libnativewindow",
        "libcamalgo.eis",
        "libcamalgo.warp",
        "libmtkcam_modulehelper",
        "libmtkcam_stdutils",
        "libmtkcam_imgbuf",
        "libmtkcam_ulog",
        "libcam.iopipe",
        "libmtkcam_rsc",
        "libdpframework",
        "libgralloc_extra",
        "libfeature_eis",
        "libfeature.face",
        "libcameracustom",
        "libcameracustom.eis",
        "libfeature_3dnr",
        "libfeature_fsc",
        "libmtkcam_tuning_utils",
        "libcam.feature_utils",
        "libmtkcam_3rdparty",
        "libmtkcam_3rdparty.core",
        "libmtkcam.featurepipe.depthmap",
        "libmtkcam.featurepipe.vsdof_util",
        "libJpgEncPipe",
        "libmtkcam_exif",
        "libmtkcam_metadata",
        "libfeature.stereo.provider",
        "libion",
        "libmtkcam_debugutils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
