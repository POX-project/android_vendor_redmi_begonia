// Android.bp for reverse-engineered libmfllcore.so
cc_library_shared {
    name: "libmfllcore",
    vendor: true,
    srcs: [
        "libmfllcore.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libcamalgo.mfnr",
        "libmtkcam_hwutils",
        "libcameracustom",
        "libmtkcam_imgbuf",
        "libcam.iopipe",
        "libmtkcam_metadata",
        "libmtkcam_modulehelper",
        "libmtkcam_mfb",
        "libdpframework",
        "libmtkcam_mapping_mgr",
        "libaedv",
        "libladder",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
