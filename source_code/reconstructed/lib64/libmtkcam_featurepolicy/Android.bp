// Android.bp for reverse-engineered libmtkcam_featurepolicy.so
cc_library_shared {
    name: "libmtkcam_featurepolicy_gki",
    vendor: true,
    srcs: [
        "libmtkcam_featurepolicy.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libmtkcam_stdutils",
        "libmtkcam_hwutils",
        "libmtkcam_metadata",
        "libmtkcam_metastore",
        "libmtkcam_3rdparty",
        "libmtkcam_3rdparty.core",
        "libmtkcam_modulehelper",
        "libmtkcam_exif",
        "libmtkcam_sysutils",
        "libcameracustom",
        "libcameracustom.eis",
        "libfeature.stereo.provider",
        "vendor.mediatek.hardware.camera.atms@1.0",
        "libmtkcam.atmseventmgr",
        "libaedv",
        "libcam.feature_utils",
        "libc++",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
