// Android.bp for reverse-engineered libkeymaster_portable.so
cc_library_shared {
    name: "libkeymaster_portable",
    vendor: true,
    srcs: [
        "libkeymaster_portable.cpp",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "libcrypto",
        "libc",
        "libm",
        "libdl",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-O2",
    ],
    relative_install_path: "hw",
}
