cc_binary {
    name: "android.hardware.lights-service.begonia",
    relative_install_path: "hw",
    init_rc: ["android.hardware.lights-service.begonia.rc"],
    vintf_fragments: ["android.hardware.lights-service.begonia.xml"],
    vendor: true,
    srcs: [
        "Lights.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libhardware",
        "libbinder_ndk",
        "android.hardware.light-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
