// AIDL Consumer IR service for Android 14/15/16
cc_binary {
    name: "android.hardware.ir-service.begonia",
    relative_install_path: "hw",
    init_rc: ["android.hardware.ir-service.begonia.rc"],
    vintf_fragments: ["android.hardware.ir-service.begonia.xml"],
    vendor: true,
    srcs: [
        "ConsumerIrAidl.cpp",
        "service_aidl.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "android.hardware.ir-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}

// Legacy HIDL Consumer IR service
cc_binary {
    name: "android.hardware.ir@1.0-service.begonia",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.ir@1.0-service.begonia.rc"],
    vintf_fragments: ["android.hardware.ir@1.0-service.begonia.xml"],
    vendor: true,
    srcs: [
        "ConsumerIr.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libhardware",
        "libhidlbase",
        "libutils",
        "android.hardware.ir@1.0",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
